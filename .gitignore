# ==========================================
# Sangam Fabricators - Git Ignore Rules
# ==========================================

# 1. Agent & Automation Scripts (Temporary files used by AI)
*.py
*.pyc
__pycache__/

# 2. Heavy Media & References (Don't bloat the repo)
assets/sandhill_ref.mp4
assets/**/*.mp4
*.mov
*.avi

# 3. OS Generated Files (Windows & Mac)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
[Tt]humbs.db
[Dd]esktop.ini

# 4. Editor & IDEs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# 5. General Web/Node (Future-proofing)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.local

# 6. Logs & Temp Folders
*.log
tmp/
temp/
.tempmediaStorage/
