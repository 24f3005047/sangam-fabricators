# ==========================================
# Sangam Fabricators - Git Ignore Rules
# ==========================================

# 1. Agent & Automation Scripts (Temporary files used by AI)
*.py
*.pyc
__pycache__/

# 2. Heavy Media & References (Don't bloat the repo)
assets/**/*.mp4
assets/**/*.mov
assets/**/*.avi
*.mp4
*.mov
*.avi
*.mkv

# 3. Archives & Backups
*.zip
*.tar.gz
*.rar
*.bak
*.tmp
*.orig
*~

# 4. OS Generated Files (Windows & Mac)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
[Tt]humbs.db
[Dd]esktop.ini

# 5. Editor, IDEs, & AI Tools
.vscode/
.idea/
.cursor/
.gemini/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# 6. General Web, Build Outputs, Caches & Node
node_modules/
dist/
build/
out/
.cache/
.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.*
!.env.example

# 7. Security, Keys & Credentials
*.pem
*.key
*.cert
*.crt

# 8. Logs, Dumps & Temp Folders
*.log
*.stackdump
*.dmp
tmp/
temp/
coverage/
.nyc_output/
.tempmediaStorage/
scratch/
